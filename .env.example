# Add these in Vercel Project Settings → Environment Variables.
# Never commit a real value to GitHub or expose it in browser code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_PASSWORD=choose-a-long-unique-shared-password
# Use at least 32 random characters. Example generator: openssl rand -base64 48
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
